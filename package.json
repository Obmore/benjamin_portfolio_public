{
  "name": "benjamin_portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && tsc -p tsconfig.e2e.json",
    "preview": "vite preview",
    "deploy": "gh workflow run deploy.yml --ref main",
    "build:fonts": "node scripts/build-fonts.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "check:size": "node scripts/check-budgets.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "check:megrendeles": "node scripts/check-megrendeles.mjs",
    "check:static": "node scripts/check-static-pages.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:site": "node scripts/check-site.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test:scripts && npm run build && npm run check:size && npm run check:motion && npm run check:megrendeles && npm run check:static && npm run check:privacy && npm run check:site"
  },
  "dependencies": {
    "zdog": "1.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capsizecss/metrics": "^4.5.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/martian-mono": "5.3.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/zdog": "1.1.7",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.94.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.8"
  }
}
